NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# PostgreSQL real. No subas credenciales reales al repositorio.
# Ejemplo Supabase: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Opcional si usas Supabase desde scripts/backend. Nunca expongas service role en frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

JWT_SECRET=change_this_to_a_random_secret_with_at_least_32_chars
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password