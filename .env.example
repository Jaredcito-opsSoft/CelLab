NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# PostgreSQL real. No subas credenciales reales al repositorio.
# Ejemplo Supabase: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# Con Supabase Session Pooler usa un valor conservador por instancia de API.
DB_POOL_MAX=5
TRUST_PROXY=0
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
RELEASE_VERSION=development

JWT_SECRET=change_this_to_a_random_secret_with_at_least_32_chars
JWT_EXPIRES_IN=8h
SMOKE_TEST_MODE=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
