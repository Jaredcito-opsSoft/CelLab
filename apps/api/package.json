{
    "name":  "@cellab/api",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/main.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/main.js",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test:contracts":  "tsx --test src/tests/contracts.test.ts src/tests/managerial-reports.test.ts",
                    "db:generate":  "drizzle-kit generate",
                    "db:migrate":  "drizzle-kit migrate",
                    "db:seed":  "tsx src/db/seed.ts",
                    "db:seed:demo":  "tsx src/scripts/seed-demo.ts",
                    "smoke:permissions":  "tsx src/scripts/smoke-permissions.ts",
                    "smoke:modules":  "tsx src/scripts/smoke-modules.ts",
                    "smoke:purchases":  "tsx src/scripts/smoke-purchases.ts",
                    "smoke:pos-complete":  "tsx src/scripts/smoke-pos-complete.ts",
                    "smoke:multi-register":  "tsx src/scripts/smoke-multi-register.ts",
                    "smoke:cash-concurrency":  "tsx src/scripts/smoke-cash-concurrency.ts",
                    "smoke:release":  "tsx src/scripts/smoke-release.ts",
                    "smoke:warranty":  "tsx src/scripts/smoke-warranty.ts",
                    "smoke:reports":  "tsx src/scripts/smoke-reports.ts",
                    "smoke:tenant-foundation":  "tsx src/scripts/smoke-tenant-foundation.ts"
                    ,"audit:release-db": "tsx src/scripts/audit-release-database.ts",
                    "load:release:readonly": "tsx src/scripts/load-release-readonly.ts"
                },
    "dependencies":  {
                         "bcryptjs":  "^3.0.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.5.0",
                         "drizzle-orm":  "^0.45.2",
                         "express":  "^5.1.0",
                         "express-rate-limit":  "^8.5.2",
                         "helmet":  "^8.1.0",
                         "jose":  "^6.2.3",
                         "postgres":  "^3.4.9",
                         "zod":  "^3.25.28"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.18",
                            "@types/express":  "^5.0.2",
                            "@types/node":  "^22.15.21",
                            "drizzle-kit":  "^0.31.10",
                            "tsx":  "^4.19.4",
                            "typescript":  "^5.8.3"
                        }
}
